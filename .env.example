LUMENWATCH_DATABASE_PATH=data/lumenwatch.db
LUMENWATCH_CAPTURE_DIR=data/captures
LUMENWATCH_HOST=127.0.0.1
LUMENWATCH_PORT=8020
LUMENWATCH_BROWSER_ENABLED=false
LUMENWATCH_SCHEDULER_ENABLED=false
LUMENWATCH_SCHEDULER_TICK_SECONDS=60

# Protected public API behind your TLS proxy.
# LUMENWATCH_PUBLIC_ORIGIN=https://monitor.example.com
# LUMENWATCH_AUTH_TOKEN=
# Required for browser capture in public mode; build locally first.
# LUMENWATCH_ISOLATED_BROWSER_IMAGE=lumenwatch-browser:1.64.1
